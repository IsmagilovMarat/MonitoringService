@page
@model IndexModel
@{
    ViewData["Title"] = "Анализ сайтов";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Мониторинг сайтов</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            padding: 25px 35px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left h1 {
            color: #2c3e50;
            font-weight: 600;
            margin: 0;
            font-size: 28px;
        }

        .header-left p {
            color: #7f8c8d;
            margin: 5px 0 0 0;
            font-size: 14px;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
        }

        .logout-btn {
            background: transparent;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 8px 20px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .logout-btn:hover {
                background: #667eea;
                color: white;
                transform: translateY(-2px);
            }

        .content-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            padding: 30px;
        }

        .alert {
            border-radius: 12px;
            border: none;
            animation: fadeIn 0.5s ease;
        }

        .alert-success {
            background: linear-gradient(135deg, #38c172 0%, #2d995b 100%);
            color: white;
        }

        .alert-warning {
            background: linear-gradient(135deg, #ffed4a 0%, #f1c40f 100%);
            color: #2c3e50;
        }

        .alert-info {
            background: linear-gradient(135deg, #6cb2eb 0%, #3490dc 100%);
            color: white;
        }

        .alert-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%);
            color: white;
        }

        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            overflow: hidden;
            margin-bottom: 25px;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            }

        .card-header {
            padding: 20px;
            font-weight: 600;
            font-size: 18px;
            border-bottom: none;
        }

        .card-body {
            padding: 25px;
        }

        .bg-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        }

        .bg-success {
            background: linear-gradient(135deg, #38c172 0%, #2d995b 100%) !important;
        }

        .bg-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%) !important;
        }

        .bg-warning {
            background: linear-gradient(135deg, #ffed4a 0%, #f1c40f 100%) !important;
        }

        .bg-info {
            background: linear-gradient(135deg, #6cb2eb 0%, #3490dc 100%) !important;
        }

        .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: #f8f9fa;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                background: white;
            }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(102, 126, 234, 0.3);
            }

        .badge {
            border-radius: 10px;
            padding: 6px 12px;
            font-weight: 500;
        }

        .list-group-item {
            border: 1px solid #e0e0e0;
            padding: 12px 20px;
        }

        .result-icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .floating-icon {
            position: fixed;
            font-size: 24px;
            color: rgba(255, 255, 255, 0.1);
            animation: float 6s ease-in-out infinite;
            z-index: -1;
        }

            .floating-icon:nth-child(1) {
                top: 10%;
                left: 5%;
            }

            .floating-icon:nth-child(2) {
                top: 15%;
                right: 8%;
                animation-delay: 1s;
            }

            .floating-icon:nth-child(3) {
                bottom: 20%;
                left: 10%;
                animation-delay: 2s;
            }

            .floating-icon:nth-child(4) {
                bottom: 15%;
                right: 5%;
                animation-delay: 3s;
            }

        .security-high {
            background: #d4edda;
            color: #155724;
            padding: 4px 8px;
            border-radius: 8px;
        }

        .security-medium {
            background: #fff3cd;
            color: #856404;
            padding: 4px 8px;
            border-radius: 8px;
        }

        .security-low {
            background: #f8d7da;
            color: #721c24;
            padding: 4px 8px;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <div class="floating-icon"><i class="fas fa-shield-alt"></i></div>
    <div class="floating-icon"><i class="fas fa-search"></i></div>
    <div class="floating-icon"><i class="fas fa-chart-bar"></i></div>
    <div class="floating-icon"><i class="fas fa-lock"></i></div>

    <div class="main-container">
        <div class="header">
            <div class="header-left">
                <h1><i class="fas fa-chart-line"></i> Мониторинг сайтов</h1>
                <p>Анализ нецензурной лексики, Google Forms, экстремистских материалов и ПД</p>
            </div>
            <div>
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar"><i class="fas fa-user"></i></div>
                    <div>
                        <div style="font-weight: 500; color: #2c3e50;">Администратор</div>
                        <small style="color: #7f8c8d;">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <a href="/Logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Выйти</a>
                </div>
            </div>
        </div>

        <div class="content-container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["WarningMessage"]
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-times-circle"></i> @Model.ErrorMessage
                </div>
            }

            <!-- Форма ввода URL (ОДНА) -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-search"></i> Введите URL для анализа</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="AnalyzeSite">
                        <div class="mb-3">
                            <label asp-for="SiteUrl" class="form-label">URL сайта:</label>
                            <input type="url" asp-for="SiteUrl" class="form-control" placeholder="https://example.com" required>
                            <div class="form-text">Будет выполнен полный анализ: нецензурная лексика, Google Forms, экстремистские материалы, согласие на обработку ПД</div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="analyzeBtn">
                            <i class="fas fa-rocket"></i> Запустить анализ
                        </button>
                    </form>
                </div>
            </div>

            <!-- РЕЗУЛЬТАТЫ АНАЛИЗА (ПО ПОРЯДКУ) -->
            @if (Model.HasResults)
            {
                <!-- 1. Информация о словаре -->
                @if (Model.DictionaryInfo != null)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-book"></i> Словарь нецензурных слов: <strong>@Model.DictionaryInfo.TotalWords</strong> слов загружено
                        @if (Model.DictionaryInfo.MLEnabled)
                        {
                            <span class="badge bg-primary ms-2">ML Detector Active</span>
                        }
                    </div>
                }

                <!-- 2. Проверка экстремистских материалов -->
                @if (Model.ExtremistCheckResult != null)
                {
                    <div class="card">
                        <div class="card-header @(Model.ExtremistCheckResult.HasExtremistMaterials ? "bg-danger" : "bg-success") text-white">
                            <i class="fas fa-gavel"></i> Проверка на экстремистские материалы
                        </div>
                        <div class="card-body text-center py-4">
                            @if (Model.ExtremistCheckResult.HasExtremistMaterials)
                            {
                                <i class="fas fa-exclamation-triangle result-icon" style="color: #e3342f;"></i>
                                <h5 class="text-danger">⚠️ Обнаружены экстремистские материалы!</h5>
                                <p>Найдено <strong>@Model.ExtremistCheckResult.FoundMaterials.Count</strong> упоминаний</p>
                            }
                            else
                            {
                                <i class="fas fa-check-circle result-icon" style="color: #38c172;"></i>
                                <h5 class="text-success">✓ Экстремистские материалы не обнаружены</h5>
                            }
                        </div>
                    </div>
                }

                <!-- 3. Проверка нецензурной лексики -->
                @if (Model.AnalysisResult != null)
                {
                    <div class="card">
                        <div class="card-header @(Model.AnalysisResult.HasBadWords ? "bg-danger" : "bg-success") text-white">
                            <i class="fas fa-ban"></i> Анализ нецензурной лексики
                        </div>
                        <div class="card-body text-center py-4">
                            @if (Model.AnalysisResult.HasBadWords)
                            {
                                <i class="fas fa-exclamation-triangle result-icon" style="color: #e3342f;"></i>
                                <h5 class="text-danger">⚠️ Обнаружена нецензурная лексика!</h5>
                                <p>
                                    Всего вхождений: <strong>@Model.AnalysisResult.TotalBadWordsCount</strong><br>
                                    Уникальных слов: <strong>@Model.AnalysisResult.BadWordsFound.Count</strong>
                                </p>
                                @if (Model.AnalysisResult.BadWordsFound.Any())
                                {
                                    <div class="mt-2">
                                        <strong>Найденные слова:</strong>
                                        <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                                            @foreach (var word in Model.AnalysisResult.BadWordsFound.OrderByDescending(w => w.Value).Take(10))
                                            {
                                                <span class="badge bg-danger">@word.Key (@word.Value)</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <i class="fas fa-check-circle result-icon" style="color: #38c172;"></i>
                                <h5 class="text-success">✓ Нецензурные слова не обнаружены</h5>
                            }
                        </div>
                    </div>
                }

                <!-- 4. Проверка Google Forms -->
                @if (Model.GoogleFormsResult != null)
                {
                    <div class="card">
                        <div class="card-header @(Model.GoogleFormsResult.HasGoogleForms ? "bg-danger" : "bg-success") text-white">
                            <i class="fab fa-google"></i> Google Forms Detection
                        </div>
                        <div class="card-body text-center py-4">
                            @if (Model.GoogleFormsResult.HasGoogleForms)
                            {
                                <i class="fab fa-google result-icon" style="color: #ea4335;"></i>
                                <h5 class="text-danger">⚠️ Обнаружены Google Forms!</h5>
                                <p>Найдено форм: <strong>@Model.GoogleFormsResult.FormUrls.Count</strong></p>
                                @if (Model.GoogleFormsResult.IsPotentiallyMalicious)
                                {
                                    <div class="alert alert-danger mt-2">⚠️ Потенциально вредоносные формы!</div>
                                }
                            }
                            else
                            {
                                <i class="fab fa-google result-icon" style="color: #38c172;"></i>
                                <h5 class="text-success">✓ Google Forms не обнаружены</h5>
                            }
                        </div>
                    </div>
                }

                <!-- 5. Проверка согласия на обработку ПД -->
                @if (Model.ConsentResult != null)
                {
                    <div class="card">
                        <div class="card-header @(Model.ConsentResult.IsCompliant ? "bg-success" : "bg-warning") text-white">
                            <i class="fas fa-shield-alt"></i> Согласие на обработку персональных данных
                        </div>
                        <div class="card-body text-center py-4">
                            @if (Model.ConsentResult.IsCompliant)
                            {
                                <i class="fas fa-check-circle result-icon" style="color: #38c172;"></i>
                                <h5 class="text-success">✓ Согласие на обработку ПД найдено</h5>
                            }
                            else
                            {
                                <i class="fas fa-exclamation-triangle result-icon" style="color: #f1c40f;"></i>
                                <h5 class="text-warning">⚠️ Согласие на обработку ПД не обнаружено</h5>
                                <p>Отсутствует форма согласия, чекбокс или политика конфиденциальности</p>
                            }
                        </div>
                    </div>
                }

                <!-- Таблица пользователей -->
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <i class="fas fa-users"></i> Пользователи системы
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr><th>Имя</th><th>Фамилия</th><th>Email</th><th>Роль</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td><strong>@user.Name</strong></td>
                                            <td>@user.SecondName</td>
                                            <td>@user.Email</td>
                                            <td><span class="badge @(user.UserRole?.RoleName == "Admin" ? "bg-danger" : "bg-primary")">@user.UserRole?.RoleName</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('analyzeBtn')?.addEventListener('click', function(e) {
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Анализ...';
        });
    </script>
</body>
</html>