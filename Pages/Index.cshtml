@page
@model IndexModel
@{
    ViewData["Title"] = "Администрирование - Мониторинг сайтов";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 15px 25px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-kfu {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 1rem;
        }

            .btn-kfu:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(17, 153, 142, 0.4);
                color: white;
            }

        .admin-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            color: white;
        }

        .btn-outline-light {
            border-radius: 12px;
            padding: 8px 20px;
            transition: all 0.3s ease;
        }

            .btn-outline-light:hover {
                transform: translateY(-2px);
            }

        .header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

            .header h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
            background: rgba(255, 255, 255, 0.98);
            margin-bottom: 25px;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 20px 20px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(102, 126, 234, 0.3);
            }

        .alert {
            border-radius: 12px;
            border: none;
        }

        .alert-success {
            background: linear-gradient(135deg, #38c172 0%, #2d995b 100%);
            color: white;
        }

        .alert-warning {
            background: linear-gradient(135deg, #ffed4a 0%, #f1c40f 100%);
            color: #2c3e50;
        }

        .alert-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%);
            color: white;
        }

        .alert-info {
            background: linear-gradient(135deg, #6cb2eb 0%, #3490dc 100%);
            color: white;
        }

        .table {
            border-radius: 16px;
            overflow: hidden;
        }

            .table thead th {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border: none;
                padding: 15px;
            }

        .badge {
            border-radius: 10px;
            padding: 6px 12px;
            font-weight: 500;
        }

        /* Стили для деталей нарушений */
        .material-card {
            background: #fff5f5;
            border-left: 4px solid #e3342f;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .material-number {
            font-size: 1.1rem;
            font-weight: bold;
            color: #e3342f;
        }

        .material-keyword {
            background: #e3342f;
            color: white;
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 0.85rem;
            display: inline-block;
        }

        .material-context {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 0.9rem;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <!-- Верхняя панель -->
        <div class="top-bar">
            <div class="nav-buttons">
                <a href="/PortalPages" class="btn-kfu">
                    <i class="fas fa-university"></i> КФУ проверка
                </a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="admin-badge"><i class="fas fa-crown"></i> Администратор</span>
                <a href="/Logout" class="btn btn-outline-light" style="color: white; border-color: white;">
                    <i class="fas fa-sign-out-alt"></i> Выйти
                </a>
            </div>
        </div>

        <!-- Header -->
        <div class="header">
            <h1><i class="fas fa-shield-alt"></i> Админ панель мониторинга</h1>
            <p>Профессиональная проверка сайтов на наличие нецензурной лексики и запрещенного контента</p>
        </div>

        <!-- Форма ввода URL -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-search"></i> Проверка сайта
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> @TempData["WarningMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-times-circle"></i> @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" asp-page-handler="AnalyzeSite" id="analyzeForm">
                    <div class="mb-3">
                        <label for="SiteUrl" class="form-label fw-bold">
                            <i class="fas fa-link"></i> URL сайта для проверки:
                        </label>
                        <input type="url"
                               class="form-control @(ViewData.ModelState["SiteUrl"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               id="SiteUrl"
                               asp-for="SiteUrl"
                               placeholder="https://example.com"
                               required>
                        <div class="invalid-feedback">
                            @ViewData.ModelState["SiteUrl"]?.Errors.FirstOrDefault()?.ErrorMessage
                        </div>
                        <div class="form-text mt-2">
                            <i class="fas fa-info-circle"></i> Введите полный URL сайта, включая http:// или https://
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="analyzeBtn">
                        <i class="fas fa-search"></i> Начать анализ
                    </button>
                </form>
            </div>
        </div>

        <!-- Результаты анализа -->
        @if (Model.HasResults)
        {
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-chart-bar"></i> Результаты анализа
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5><i class="fas fa-chart-simple"></i> Статистика проверки:</h5>
                            <ul class="list-group mt-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Проверенный URL
                                    <span class="badge bg-secondary rounded-pill">@Model.SiteUrl</span>
                                </li>
                                @if (Model.AnalysisResult != null)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Нецензурная лексика
                                        <span class="badge @(Model.AnalysisResult.HasBadWords ? "bg-danger" : "bg-success") rounded-pill">
                                            @(Model.AnalysisResult.HasBadWords ? $"Найдено: {Model.AnalysisResult.TotalBadWordsCount}" : "Безопасно")
                                        </span>
                                    </li>
                                }
                                @if (Model.GoogleFormsResult != null)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Google Forms
                                        <span class="badge @(Model.GoogleFormsResult.HasGoogleForms ? "bg-warning" : "bg-success") rounded-pill">
                                            @(Model.GoogleFormsResult.HasGoogleForms ? $"Найдено: {Model.GoogleFormsResult.FormUrls.Count}" : "Не найдены")
                                        </span>
                                    </li>
                                }
                                @if (Model.ExtremistCheckResult != null)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Экстремистские материалы
                                        <span class="badge @(Model.ExtremistCheckResult.HasExtremistMaterials ? "bg-danger" : "bg-success") rounded-pill">
                                            @(Model.ExtremistCheckResult.HasExtremistMaterials ? $"Найдено: {Model.ExtremistCheckResult.FoundMaterials.Count}" : "Не найдены")
                                        </span>
                                    </li>
                                }
                                @if (Model.ConsentResult != null)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        Согласие на обработку ПД
                                        <span class="badge @(Model.ConsentResult.IsCompliant ? "bg-success" : "bg-warning") rounded-pill">
                                            @(Model.ConsentResult.IsCompliant ? "Есть" : "Нет")
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Детали найденных экстремистских материалов -->
                    @if (Model.ExtremistCheckResult != null && Model.ExtremistCheckResult.HasExtremistMaterials && Model.ExtremistCheckResult.FoundMaterials.Any())
                    {
                        <div class="mt-4">
                            <h5 class="text-danger">
                                <i class="fas fa-exclamation-triangle"></i> Детали найденных экстремистских материалов:
                            </h5>
                            @foreach (var material in Model.ExtremistCheckResult.FoundMaterials)
                            {
                                <div class="material-card">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="material-number">Материал №@material.Number</span>
                                            @if (!string.IsNullOrEmpty(material.MatchedKeyword))
                                            {
                                                <span class="material-keyword ms-2">
                                                    <i class="fas fa-search"></i> "@material.MatchedKeyword"
                                                </span>
                                            }
                                        </div>
                                        @if (material.DecisionDate.HasValue)
                                        {
                                            <small class="text-muted">Дата решения: @material.DecisionDate.Value.ToString("dd.MM.yyyy")</small>
                                        }
                                    </div>
                                    <p class="mb-2"><strong>Описание:</strong> @material.Description</p>
                                    @if (!string.IsNullOrEmpty(material.Context))
                                    {
                                        <div class="material-context">
                                            <i class="fas fa-quote-left text-muted me-1"></i>
                                            @material.Context
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Детали найденных нецензурных слов -->
                    @if (Model.AnalysisResult != null && Model.AnalysisResult.HasBadWords && Model.AnalysisResult.BadWordsFound.Any())
                    {
                        <div class="mt-4">
                            <h5 class="text-warning">
                                <i class="fas fa-ban"></i> Найденные нецензурные слова:
                            </h5>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var word in Model.AnalysisResult.BadWordsFound.OrderByDescending(w => w.Value).Take(20))
                                {
                                    <span class="badge bg-danger">
                                        @word.Key (@word.Value)
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Детали найденных Google Forms -->
                    @if (Model.GoogleFormsResult != null && Model.GoogleFormsResult.HasGoogleForms && Model.GoogleFormsResult.FormUrls.Any())
                    {
                        <div class="mt-4">
                            <h5 class="text-warning">
                                <i class="fab fa-google"></i> Найденные Google Forms:
                            </h5>
                            <ul class="mt-2">
                                @foreach (var form in Model.GoogleFormsResult.FormUrls.Take(10))
                                {
                                    <li><a href="@form" target="_blank">@form</a></li>
                                }
                            </ul>
                            @if (Model.GoogleFormsResult.IsPotentiallyMalicious)
                            {
                                <div class="alert alert-danger mt-2">
                                    <i class="fas fa-exclamation-triangle"></i> ⚠️ Обнаружены потенциально вредоносные формы!
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Таблица пользователей -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-users"></i> Пользователи системы
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Имя</th><th>Фамилия</th><th>Email</th><th>Роль</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td><strong>@user.Name</strong></td>
                                    <td>@user.SecondName</td>
                                    <td>@user.Email</td>
                                    <td><span class="badge @(user.UserRole?.RoleName == "Admin" ? "bg-danger" : "bg-primary")">@user.UserRole?.RoleName</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('analyzeBtn')?.addEventListener('click', function(e) {
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Анализ...';
        });
    </script>
</body>
</html>