@page
@model MonitoringServiceCore.Pages.UsersMainPageModel
@{
    Layout = null;
    ViewData["Title"] = "Анализ сайтов - проверка контента";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

            .header h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
            background: rgba(255, 255, 255, 0.98);
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 20px 20px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .form-control {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(102, 126, 234, 0.3);
            }

            .btn-primary:disabled {
                opacity: 0.7;
                transform: none;
            }

        .checks-list {
            margin-top: 30px;
        }

        .check-item {
            background: white;
            border-radius: 16px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

            .check-item:hover {
                transform: translateX(5px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            }

        .check-header {
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            background: white;
            transition: background 0.3s ease;
        }

            .check-header:hover {
                background: #f8f9fa;
            }

        .check-icon {
            font-size: 2rem;
            min-width: 60px;
            text-align: center;
        }

        .check-info {
            flex: 1;
        }

            .check-info h4 {
                margin: 0 0 5px 0;
                font-size: 1.2rem;
                color: #2c3e50;
            }

            .check-info p {
                margin: 0;
                color: #6c757d;
                font-size: 0.9rem;
            }

        .check-status {
            min-width: 160px;
            text-align: right;
        }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-success {
            background: #d4edda;
            color: #155724;
        }

        .status-danger {
            background: #f8d7da;
            color: #721c24;
        }

        .status-warning {
            background: #fff3cd;
            color: #856404;
        }

        .status-info {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-pending {
            background: #e2e3e5;
            color: #383d41;
        }

        .check-arrow {
            color: #667eea;
            font-size: 1.2rem;
            transition: transform 0.3s ease;
            margin-left: 10px;
        }

        .check-item.active .check-arrow {
            transform: rotate(90deg);
        }

        .check-details {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s ease-out;
            background: #f8f9fa;
            border-top: 1px solid #e0e0e0;
        }

        .check-item.active .check-details {
            max-height: 800px;
            transition: max-height 0.5s ease-in;
        }

        .check-details-content {
            padding: 20px;
        }

        .detail-section {
            margin-bottom: 15px;
        }

            .detail-section strong {
                color: #667eea;
                display: block;
                margin-bottom: 8px;
            }

        .badge-risk {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .risk-high {
            background: #fee;
            color: #e3342f;
        }

        .risk-medium {
            background: #fef3c7;
            color: #f1c40f;
        }

        .risk-low {
            background: #e3f2fd;
            color: #3490dc;
        }

        .risk-critical {
            background: #dc3545;
            color: white;
        }

        .result-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #667eea;
        }

        .alert {
            border-radius: 12px;
            border: none;
        }

        .alert-success {
            background: linear-gradient(135deg, #38c172 0%, #2d995b 100%);
            color: white;
        }

        .alert-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%);
            color: white;
        }

        .alert-warning {
            background: linear-gradient(135deg, #ffed4a 0%, #f1c40f 100%);
            color: #2c3e50;
        }

        .alert-info {
            background: linear-gradient(135deg, #6cb2eb 0%, #3490dc 100%);
            color: white;
        }

        .material-card {
            background: #fff5f5;
            border-left: 4px solid #e3342f;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .material-number {
            font-size: 1.1rem;
            font-weight: bold;
            color: #e3342f;
        }

        .material-keyword {
            background: #e3342f;
            color: white;
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 0.85rem;
            display: inline-block;
        }

        .material-context {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 0.9rem;
            margin-top: 10px;
        }

        .google-forms-card {
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid #e0e0e0;
        }

        .violation-count {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .loading-content {
            background: white;
            padding: 30px;
            border-radius: 20px;
            text-align: center;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
    </style>
</head>
<body>
    @if (Model.IsAnalyzing)
    {
        <div class="loading-overlay">
            <div class="loading-content">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 mb-0">Анализ сайта... Пожалуйста, подождите</p>
            </div>
        </div>
    }

    <div class="container-custom">
        <div class="header">
            <h1><i class="fas fa-shield-alt"></i> Мониторинг сайтов</h1>
            <p>Профессиональная проверка сайтов на наличие нецензурной лексики, экстремистских материалов и нарушений ПД</p>
            <div style="text-align: right; margin-bottom: 20px;">
                <a href="/Logout" class="btn btn-outline-light" style="color: white; border-color: white;">
                    <i class="fas fa-sign-out-alt"></i> Выйти
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fas fa-search"></i> Проверка сайта
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> @TempData["WarningMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-times-circle"></i> @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" asp-page-handler="Analyze" id="analyzeForm">
                    <div class="mb-3">
                        <label for="SiteUrl" class="form-label fw-bold">
                            <i class="fas fa-link"></i> URL сайта для проверки:
                        </label>
                        <input type="url"
                               class="form-control @(ViewData.ModelState["SiteUrl"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               id="SiteUrl"
                               asp-for="SiteUrl"
                               placeholder="https://example.com"
                               required>
                        <div class="invalid-feedback">
                            @ViewData.ModelState["SiteUrl"]?.Errors.FirstOrDefault()?.ErrorMessage
                        </div>
                        <div class="form-text mt-2">
                            <i class="fas fa-info-circle"></i> Введите полный URL сайта, включая http:// или https://
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="analyzeBtn">
                        <i class="fas fa-search"></i> Начать анализ
                    </button>
                </form>
            </div>
        </div>

        @if (Model.HasResults)
        {
            <div class="card mt-4">
                <div class="card-header">
                    <i class="fas fa-chart-line"></i> Общая оценка безопасности
                </div>
                <div class="card-body text-center">
                    <div class="result-value">@Model.OverallScore / 100</div>
                    <div class="progress mt-2" style="height: 10px;">
                        <div class="progress-bar bg-@Model.OverallStatusColor"
                             role="progressbar"
                             style="width: @Model.OverallScore%">
                        </div>
                    </div>
                    <p class="mt-3">
                        <span class="badge bg-@Model.OverallStatusColor fs-6">
                            <i class="fas @(Model.OverallScore >= 80 ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
                            @Model.OverallStatus
                        </span>
                    </p>
                    <p class="text-muted mt-2">
                        <i class="fas fa-info-circle"></i>
                        Всего нарушений: <strong>@Model.TotalViolationsCount</strong>
                    </p>
                </div>
            </div>

            <div class="checks-list">
                <div class="check-item" data-check="badwords">
                    <div class="check-header">
                        <div class="check-icon">
                            <i class="fas fa-ban" style="color: #e3342f;"></i>
                        </div>
                        <div class="check-info">
                            <h4>Нецензурная лексика</h4>
                            <p>Проверка на наличие матерных слов и ненормативной лексики</p>
                        </div>
                        <div class="check-status">
                            @if (Model.HasBadWordsViolations)
                            {
                                <span class="status-badge status-danger">
                                    <i class="fas fa-exclamation-triangle"></i> Нарушений: @Model.BadWordsCount
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-success">
                                    <i class="fas fa-check-circle"></i> Безопасно
                                </span>
                            }
                        </div>
                        <div class="check-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <div class="check-details">
                        <div class="check-details-content">
                            <div class="detail-section">
                                <strong><i class="fas fa-tasks"></i> Что проверяется:</strong>
                                <p>Система сканирует весь текстовый контент сайта на наличие нецензурной лексики, включая матерные слова, оскорбления и ненормативную лексику на русском языке.</p>
                            </div>

                            @if (Model.HasBadWordsViolations && Model.AnalysisResult != null)
                            {
                                <div class="detail-section">
                                    <strong><i class="fas fa-chart-line"></i> Результаты проверки:</strong>
                                    <div class="alert alert-danger mt-2">
                                        <i class="fas fa-exclamation-triangle"></i> <strong>Обнаружены нарушения!</strong>
                                        <ul class="mt-2 mb-0">
                                            <li>Всего нецензурных слов: <strong>@Model.AnalysisResult.TotalBadWordsCount</strong></li>
                                            <li>Уникальных слов: <strong>@Model.AnalysisResult.BadWordsFound?.Count ?? 0</strong></li>
                                        </ul>
                                        @if (Model.AnalysisResult.BadWordsFound != null && Model.AnalysisResult.BadWordsFound.Any())
                                        {
                                            <div class="mt-2">
                                                <strong>Найденные слова:</strong>
                                                <div class="d-flex flex-wrap gap-2 mt-1">
                                                    @foreach (var word in Model.AnalysisResult.BadWordsFound.Take(10))
                                                    {
                                                        <span class="badge bg-danger">
                                                            @word.Key (@word.Value)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="detail-section">
                                    <div class="alert alert-success mt-2">
                                        <i class="fas fa-check-circle"></i> Нецензурная лексика не обнаружена. Сайт соответствует нормам.
                                    </div>
                                </div>
                            }

                            <div class="detail-section">
                                <strong><i class="fas fa-exclamation-triangle"></i> Уровень риска:</strong>
                                <span class="badge-risk risk-high">Высокий</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="check-item" data-check="googleforms">
                    <div class="check-header">
                        <div class="check-icon">
                            <i class="fab fa-google" style="color: #ea4335;"></i>
                        </div>
                        <div class="check-info">
                            <h4>Google Forms</h4>
                            <p>Обнаружение  Google форм</p>
                        </div>
                        <div class="check-status">
                            @if (Model.HasGoogleForms)
                            {
                                @if (Model.IsGoogleFormsMalicious)
                                {
                                    <span class="status-badge status-danger">
                                        <i class="fas fa-exclamation-triangle"></i> Вредоносные формы!
                                    </span>
                                }
                              
                            }
                            else
                            {
                                <span class="status-badge status-success">
                                    <i class="fas fa-check-circle"></i> Не найдены
                                </span>
                            }
                        </div>
                        <div class="check-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <div class="check-details">
                        <div class="check-details-content">
                            <div class="detail-section">
                                <strong><i class="fas fa-tasks"></i> Что проверяется:</strong>
                                <p>Анализируется наличие на сайте Google Forms, которые могут использоваться для сбора персональных данных, а также проверка на фишинговые формы.</p>
                            </div>

                            @if (Model.HasGoogleForms && Model.GoogleFormsResult != null)
                            {
                                <div class="detail-section">
                                    <strong><i class="fas fa-chart-line"></i> Результаты проверки:</strong>
                                    @if (Model.IsGoogleFormsMalicious)
                                    {
                                        <div class="alert alert-danger mt-2">
                                            <i class="fas fa-exclamation-triangle"></i> <strong>⚠️ Обнаружены потенциально вредоносные формы!</strong>
                                            <p class="mt-2 mb-0">Рекомендуется немедленно проверить эти формы на легитимность.</p>
                                        </div>
                                    }
                                    
                                </div>
                            }
                            else
                            {
                                <div class="detail-section">
                                    <div class="alert alert-success mt-2">
                                        <i class="fas fa-check-circle"></i> Google Forms не обнаружены.
                                    </div>
                                </div>
                            }

                            <div class="detail-section">
                                <strong><i class="fas fa-exclamation-triangle"></i> Уровень риска:</strong>
                                <span class="badge-risk risk-medium">Средний</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="check-item" data-check="extremism">
                    <div class="check-header">
                        <div class="check-icon">
                            <i class="fas fa-gavel" style="color: #f1c40f;"></i>
                        </div>
                        <div class="check-info">
                            <h4>Экстремистские материалы</h4>
                            <p>Проверка по федеральному списку экстремистских материалов</p>
                        </div>
                        <div class="check-status">
                            @if (Model.HasExtremistViolations)
                            {
                                <span class="status-badge status-danger">
                                    <i class="fas fa-exclamation-triangle"></i> Найдено: @Model.ExtremistCount
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-success">
                                    <i class="fas fa-check-circle"></i> Не найдены
                                </span>
                            }
                        </div>
                        <div class="check-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <div class="check-details">
                        <div class="check-details-content">
                            <div class="detail-section">
                                <strong><i class="fas fa-tasks"></i> Что проверяется:</strong>
                                <p>Сканирование контента на наличие материалов, включенных в федеральный список экстремистских материалов.</p>
                            </div>

                            @if (Model.HasExtremistViolations && Model.ExtremistCheckResult != null)
                            {
                                <div class="detail-section">
                                    <strong><i class="fas fa-chart-line"></i> Результаты проверки:</strong>
                                    <div class="alert alert-danger mt-2">
                                        <i class="fas fa-exclamation-triangle"></i> <strong>Обнаружены экстремистские материалы!</strong>
                                        <p class="mt-2 mb-0 small text-danger"><strong>ВНИМАНИЕ:</strong> Это может повлечь юридическую ответственность!</p>
                                    </div>

                                    @foreach (var material in Model.ExtremistCheckResult.FoundMaterials)
                                    {
                                        <div class="material-card">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <span class="material-number">Материал №@material.Number</span>
                                                    @if (!string.IsNullOrEmpty(material.MatchedKeyword))
                                                    {
                                                        <span class="material-keyword ms-2">
                                                            <i class="fas fa-search"></i> "@material.MatchedKeyword"
                                                        </span>
                                                    }
                                                </div>
                                                @if (material.DecisionDate.HasValue)
                                                {
                                                    <small class="text-muted">Дата решения: @material.DecisionDate.Value.ToString("dd.MM.yyyy")</small>
                                                }
                                            </div>
                                            <p class="mb-2"><strong>Описание:</strong> @material.Description</p>
                                            @if (!string.IsNullOrEmpty(material.Context))
                                            {
                                                <div class="material-context">
                                                    <i class="fas fa-quote-left text-muted me-1"></i>
                                                    @material.Context
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="detail-section">
                                    <div class="alert alert-success mt-2">
                                        <i class="fas fa-check-circle"></i> Экстремистские материалы не обнаружены.
                                    </div>
                                </div>
                            }

                            <div class="detail-section">
                                <strong><i class="fas fa-exclamation-triangle"></i> Уровень риска:</strong>
                                <span class="badge-risk risk-critical">Критический</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="check-item" data-check="personaldata">
                    <div class="check-header">
                        <div class="check-icon">
                            <i class="fas fa-user-shield" style="color: #3490dc;"></i>
                        </div>
                        <div class="check-info">
                            <h4>Персональные данные</h4>
                            <p>Проверка наличия согласия на обработку ПД и политики конфиденциальности</p>
                        </div>
                        <div class="check-status">
                            @if (Model.HasConsentCompliance)
                            {
                                <span class="status-badge status-success">
                                    <i class="fas fa-check-circle"></i> Соответствует
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-warning">
                                    <i class="fas fa-exclamation-triangle"></i> Нарушение
                                </span>
                            }
                        </div>
                        <div class="check-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                    <div class="check-details">
                        <div class="check-details-content">
                            <div class="detail-section">
                                <strong><i class="fas fa-tasks"></i> Что проверяется:</strong>
                                <p>Анализируется наличие политики конфиденциальности и согласия на обработку персональных данных.</p>
                            </div>

                            @if (Model.HasConsentCompliance && Model.ConsentResult != null)
                            {
                                <div class="detail-section">
                                    <div class="alert alert-success mt-2">
                                        <i class="fas fa-check-circle"></i> Сайт соответствует требованиям по обработке персональных данных.
                                    </div>
                                </div>
                            }
                            else if (Model.ConsentResult != null)
                            {
                                <div class="detail-section">
                                    <strong><i class="fas fa-chart-line"></i> Результаты проверки:</strong>
                                    <div class="alert alert-warning mt-2">
                                        <i class="fas fa-exclamation-triangle"></i> <strong>Обнаружены нарушения!</strong>
                                        <p class="mt-2 mb-0">@Model.ConsentResult/p>
                                    </div>
                                </div>
                            }

                            <div class="detail-section">
                                <strong><i class="fas fa-exclamation-triangle"></i> Уровень риска:</strong>
                                <span class="badge-risk risk-high">Высокий</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.check-item').forEach(item => {
            const header = item.querySelector('.check-header');

            header.addEventListener('click', (e) => {
                if (e.target.closest('.check-status')) return;

                document.querySelectorAll('.check-item').forEach(otherItem => {
                    if (otherItem !== item && otherItem.classList.contains('active')) {
                        otherItem.classList.remove('active');
                    }
                });

                item.classList.toggle('active');
            });
        });

        const form = document.getElementById('analyzeForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const btn = document.getElementById('analyzeBtn');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Анализ...';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const elements = document.querySelectorAll('.card, .check-item');
            elements.forEach((el, index) => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, index * 100);
            });

            @if (Model.HasBadWordsViolations)
            {
                    <text>
                    const badWordsCheck = document.querySelector('[data-check="badwords"]');
                    if (badWordsCheck) badWordsCheck.classList.add('active');
                    </text>
            }
            @if (Model.HasGoogleForms && Model.IsGoogleFormsMalicious)
            {
                    <text>
                    const googleFormsCheck = document.querySelector('[data-check="googleforms"]');
                    if (googleFormsCheck) googleFormsCheck.classList.add('active');
                    </text>
            }
            @if (Model.HasExtremistViolations)
            {
                    <text>
                    const extremismCheck = document.querySelector('[data-check="extremism"]');
                    if (extremismCheck) extremismCheck.classList.add('active');
                    </text>
            }
            @if (!Model.HasConsentCompliance)
            {
                    <text>
                    const personalDataCheck = document.querySelector('[data-check="personaldata"]');
                    if (personalDataCheck) personalDataCheck.classList.add('active');
                    </text>
            }
        });
    </script>
</body>
</html>