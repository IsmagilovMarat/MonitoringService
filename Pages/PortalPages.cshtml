@page
@model MonitoringServiceCore.Pages.PortalPagesModel
@{
    Layout = null;
    ViewData["Title"] = "КФУ проверка - Управление ресурсами";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Верхняя панель */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 15px 25px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-back {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(102, 126, 234, 0.3);
                color: white;
            }

        .kfu-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            color: white;
        }

        .btn-outline-light {
            border-radius: 12px;
            padding: 8px 20px;
            transition: all 0.3s ease;
        }

            .btn-outline-light:hover {
                transform: translateY(-2px);
            }

        .header {
            text-align: center;
            margin-bottom: 40px;
            color: white;
        }

            .header h1 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease;
            background: rgba(255, 255, 255, 0.98);
            margin-bottom: 25px;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 20px 20px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .form-control, .form-select {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(102, 126, 234, 0.3);
            }

        .btn-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%);
            border: none;
            border-radius: 10px;
            padding: 6px 16px;
            font-size: 0.9rem;
        }

        .btn-warning {
            background: linear-gradient(135deg, #ffed4a 0%, #f1c40f 100%);
            border: none;
            border-radius: 10px;
            padding: 6px 16px;
            font-size: 0.9rem;
            color: #2c3e50;
        }

        .btn-sm {
            padding: 5px 12px;
            font-size: 0.85rem;
        }

        .alert {
            border-radius: 12px;
            border: none;
        }

        .alert-success {
            background: linear-gradient(135deg, #38c172 0%, #2d995b 100%);
            color: white;
        }

        .alert-danger {
            background: linear-gradient(135deg, #e3342f 0%, #cc1f1a 100%);
            color: white;
        }

        .alert-info {
            background: linear-gradient(135deg, #6cb2eb 0%, #3490dc 100%);
            color: white;
        }

        .table {
            border-radius: 16px;
            overflow: hidden;
        }

            .table thead th {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border: none;
                padding: 15px;
            }

        .badge-active {
            background: #d4edda;
            color: #155724;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .badge-inactive {
            background: #f8d7da;
            color: #721c24;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .resource-type {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .type-website {
            background: #e3f2fd;
            color: #1976d2;
        }

        .type-api {
            background: #f3e5f5;
            color: #7b1fa2;
        }

        .type-database {
            background: #fff3e0;
            color: #e65100;
        }

        .stats-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
        }

        .stats-number {
            font-size: 2rem;
            font-weight: bold;
        }

        .stats-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .government-badge {
            background: #764ba2;
            color: white;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            margin-left: 8px;
        }

        .text-link {
            color: #667eea;
            text-decoration: none;
        }

            .text-link:hover {
                text-decoration: underline;
            }


        }

        .animate-in {
            animation: slideIn 0.5s ease forwards;
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <!-- Верхняя панель -->
        <div class="top-bar">
            <div class="nav-buttons">
                <a href="/Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Назад к админ панели
                </a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="kfu-badge"><i class="fas fa-university"></i> КФУ портал</span>
                <a href="/Logout" class="btn btn-outline-light" style="color: white; border-color: white;">
                    <i class="fas fa-sign-out-alt"></i> Выйти
                </a>
            </div>
        </div>

        <!-- Header -->
        <div class="header">
            <h1><i class="fas fa-university"></i> КФУ проверка</h1>
            <p>Управление ресурсами для мониторинга (Правительственные порталы)</p>
        </div>

        <!-- Статистика -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stats-number">@Model.Resources.Count</div>
                    <div class="stats-label">Всего ресурсов</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stats-number">@Model.Resources.Count(r => r.IsActive)</div>
                    <div class="stats-label">Активных</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stats-number">@Model.Resources.Count(r => !r.IsActive)</div>
                    <div class="stats-label">Неактивных</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stats-number">@Model.Resources.Count</div>
                    <div class="stats-label">Типов ресурсов</div>
                </div>
            </div>
        </div>

        <!-- Форма добавления ресурса -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-plus-circle"></i> Добавить новый ресурс
                <span class="government-badge"><i class="fas fa-building"></i> Government</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @Model.SuccessMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-times-circle"></i> @Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" asp-page-handler="Add">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="NewResource.Name" class="form-label fw-bold">
                                <i class="fas fa-tag"></i> Название ресурса
                            </label>
                            <input type="text" asp-for="NewResource.Name" class="form-control" placeholder="Введите название">
                            <span asp-validation-for="NewResource.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label asp-for="NewResource.Url" class="form-label fw-bold">
                                <i class="fas fa-link"></i> URL адрес
                            </label>
                            <input type="url" asp-for="NewResource.Url" class="form-control" placeholder="https://example.gov.ru">
                            <span asp-validation-for="NewResource.Url" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-info-circle"></i> <strong>Примечание:</strong> Все ресурсы автоматически получают тип портала <strong>"Government"</strong>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Добавить ресурс
                    </button>
                </form>
            </div>
        </div>

        <!-- Список ресурсов -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-list"></i> Список ресурсов (Government)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Название</th>
                                <th>URL</th>
                                <th>Тип</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Resources.Any())
                            {
                                @foreach (var resource in Model.Resources)
                                {
                                    <tr>
                                        <td>
                                            <strong>@resource.Name</strong>
                                            <span class="government-badge"><i class="fas fa-building"></i> Gov</span>
                                        </td>
                                        <td>
                                            <a href="@resource.Url" target="_blank" class="text-link">
                                                <i class="fas fa-external-link-alt"></i> @(resource.Url.Length > 50 ? resource.Url.Substring(0, 47) + "..." : resource.Url)
                                            </a>
                                        </td>
                                        <td>
                                            @if (resource.IsActive)
                                            {
                                                <span class="badge-active">
                                                    <i class="fas fa-check-circle"></i> Активен
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-inactive">
                                                    <i class="fas fa-ban"></i> Неактивен
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="ToggleActive" style="display: inline-block;">
                                                <input type="hidden" name="id" value="@resource.Id" />
                                                <button type="submit" class="btn btn-warning btn-sm" title="@(resource.IsActive ? "Деактивировать" : "Активировать")">
                                                    <i class="fas @(resource.IsActive ? "fa-pause" : "fa-play")"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" style="display: inline-block;">
                                                <input type="hidden" name="id" value="@resource.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="Удалить" onclick="return confirm('Вы уверены, что хотите удалить ресурс @resource.Name?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        Нет добавленных ресурсов. Добавьте первый ресурс с помощью формы выше.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Информация -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-info-circle"></i> Информация
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6><i class="fas fa-database"></i> О системе</h6>
                        <p class="text-muted small">
                            Все ресурсы, добавленные через эту страницу, автоматически получают тип портала <strong>Government</strong>.
                            Это означает, что они будут использоваться для мониторинга правительственных и государственных порталов.
                        </p>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Плавное появление элементов
        document.addEventListener('DOMContentLoaded', function() {
            const elements = document.querySelectorAll('.card');
            elements.forEach((el, index) => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
</html>